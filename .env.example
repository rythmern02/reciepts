# ───────────────────────────────────────────────────────────────
# Receipts — environment
# Everything is OPTIONAL. The app runs on public endpoints out of the box;
# keys raise rate limits and unlock indexed history.
# ───────────────────────────────────────────────────────────────

# Solana RPC. Helius is strongly recommended for deployer history + DAS metadata.
# Falls back to public mainnet RPC when unset.
HELIUS_API_KEY=
# Or supply a full RPC url directly (takes precedence over HELIUS_API_KEY):
SOLANA_RPC_URL=

# GitHub REST — unauthenticated is 60 req/hr. A fine-grained read-only token
# raises this to 5,000 req/hr. No scopes needed.
GITHUB_TOKEN=

# Public base url, used for permanent Receipt links + OG cards.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Telegram bot (optional). Create one with @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: Anthropic key. When set, section summaries are written by Claude.
# When unset, a deterministic rule-based summariser is used (still real, no mock).
ANTHROPIC_API_KEY=
